# Existing Supabase project settings. Use the public publishable key; never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional explainable ranking weights; values must be between 0 and 1.
MATCHING_WEIGHT_EXPLICIT_SKILL=0.60
MATCHING_WEIGHT_SEMANTIC_SKILL=0.20
MATCHING_WEIGHT_PREFERENCE=0.20
