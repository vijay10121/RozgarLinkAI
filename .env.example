# Supabase project settings (Project URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical public origin used for password-reset redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional compatibility for projects that still use the legacy anon key.
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new projects.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
